From de9d7c0df45d5ae2a52fafdca4bc177cb7df60cc Mon Sep 17 00:00:00 2001
From: Mieszko Syty <mieszko@ms1design.pl>
Date: Sun, 25 Oct 2026 22:14:27 +0100
Subject: [PATCH 6/6] serve: drop the Orin drafter pin
 (MJOLNIR_ATTN_DRAFT_T5=0)

The interim workaround routed the MTP drafter to the fallback because
its steps on the Mjolnir kernel replayed a stale, host-staged
cu_seqlens; the runner derives it on the device now. APPLY AFTER the
board validates config C (the drafter + the verify on Mjolnir: clean
text, >= 2 tokens/round) with config A still at ~2.10/round.
---
 src/mjolnir-cli/mjolnir_cli/dockerctl.py | 10 ----------
 1 file changed, 10 deletions(-)

diff --git a/src/mjolnir-cli/mjolnir_cli/dockerctl.py b/src/mjolnir-cli/mjolnir_cli/dockerctl.py
index 19a5076..d6ef50a 100644
--- a/src/mjolnir-cli/mjolnir_cli/dockerctl.py
+++ b/src/mjolnir-cli/mjolnir_cli/dockerctl.py
@@ -433,16 +433,6 @@ def build_run_args(
             # matters on the unified-memory board.
             "-e",
             "PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False",
-            # INTERIM CORRECTNESS WORKAROUND (2026-10-25): the MTP head's
-            # draft steps on the Mjolnir kernels poison the verify's input
-            # (the acceptance matrix: the FI drafter + the Mjolnir verify =
-            # 2.1 accepted/round + clean; the Mjolnir drafter + the FI
-            # verify = 0.69/round + clean; both Mjolnir = 0.0 + looping
-            # output). Route the drafter to the fallback until the
-            # draft-step KV-write path is fixed -- see
-            # research/runs/orin1/notes/mma-kernel-design-2.md session 6c.
-            "-e",
-            "MJOLNIR_ATTN_DRAFT_T5=0",
         ]
     for kv in backend_env(s):
         cmd += ["-e", kv]
