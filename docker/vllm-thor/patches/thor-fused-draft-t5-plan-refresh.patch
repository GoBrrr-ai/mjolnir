diff --git a/vllm/v1/worker/gpu/spec_decode/autoregressive/speculator.py b/vllm/v1/worker/gpu/spec_decode/autoregressive/speculator.py
index f1e9fd013..17ed0ea13 100644
--- a/vllm/v1/worker/gpu/spec_decode/autoregressive/speculator.py
+++ b/vllm/v1/worker/gpu/spec_decode/autoregressive/speculator.py
@@ -283,6 +283,24 @@ class AutoRegressiveSpeculator(DraftModelSpeculator):
         num_speculative_steps: int,
     ) -> None:
         if batch_desc.cg_mode == CUDAGraphMode.FULL:
+            # Rebuild the draft attention metadata before replaying the
+            # captured graph. The replayed launches read the persistent
+            # buffers, but a builder may derive host-side per-cycle state
+            # from this cycle's seq_lens - Mjolnir's T5 split-KV work plan is
+            # computed on the host and copied into persistent buffers in
+            # build(), so skipping the build here bakes the capture-time plan
+            # in forever and the drafter attends a truncated context from the
+            # second draft step on (0.31.x built the metadata unconditionally
+            # on this path; keep that side effect). The returned metadata
+            # itself is unused - the graph replays baked launches.
+            if not skip_attn:
+                self._build_uniform_attn_metadata(
+                    num_reqs=num_reqs,
+                    batch_desc=batch_desc,
+                    num_query_per_req=1,
+                    seq_lens_cpu_upper_bound=seq_lens_cpu_upper_bound,
+                    step=1,
+                )
             self._map_kernel_block_tables()
             assert self.decode_cudagraph_manager is not None
             self.decode_cudagraph_manager.run_fullgraph(batch_desc)
