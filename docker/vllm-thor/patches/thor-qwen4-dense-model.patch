+        # THOR_QWEN4_DENSE: hybrid dense/MoE, qwen3_next's rule verbatim.
+        # A dense checkpoint ships num_experts > 0 (the config class rejects
+        # num_experts <= 0) and lists EVERY layer in mlp_only_layers; absent
+        # there this reduces to the stock all-MoE behavior, so existing
+        # checkpoints are unaffected.
+        mlp_only_layers = (
+            [] if not hasattr(config, "mlp_only_layers") else config.mlp_only_layers
         )
+        num_experts = getattr(config, "num_experts", 0) or 0
+        is_moe_layer = (self.layer_idx not in mlp_only_layers) and (
+            num_experts > 0
+            and (self.layer_idx + 1) % getattr(config, "decoder_sparse_step", 1) == 0
+        )
+        if is_moe_layer:
+            self.mlp = Qwen4ExpSparseMoeBlock(
+                vllm_config=vllm_config,
+                prefix=f"{prefix}.mlp",
+                reduce_results=not self.use_hc_sequence_parallel,
+            )
+        else:
+            assert num_experts <= 0 or mlp_only_layers, (
+                "a dense qwen4_exp decoder needs every layer in "
+                "mlp_only_layers (transformers rejects num_experts <= 0)"
+            )
+            assert getattr(config, "intermediate_size", None), (
+                "a dense qwen4_exp decoder needs config.intermediate_size"
+            )
+            self.mlp = Qwen3NextMLP(
