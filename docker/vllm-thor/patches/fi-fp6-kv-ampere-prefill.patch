+// MJOLNIR_FP6_KV: expand a produced fp6 tile in place. Each b128 slot of the
+// swizzled tile holds one KV row's 16 consecutive e2m3 codes packed into the
+// first 12 bytes (4 codes per 3 bytes, LSB-first — the kvfp6 row layout);
+// rewrite the slot to 16 e4m3 bytes (code * s_channel) so the tile becomes
+// byte-identical to an fp8 tile and every downstream path (the per-fragment
+// vec_cast in compute_qk/compute_sfm_v) runs unchanged. Channel scales are
+// per (kv_head, channel) floats, identical for every KV row, so this is a
+// flat thread-strided pass like repack_fp8_tile_to_bf16 — no cross-lane
+// fragment swizzle, and no function-local LUT (nvcc places those in local
+// memory — the measured FlashInfer #4746 trap); e2m3→half is the native
+// conversion table.
+template <typename KTraits, uint32_t HEAD_DIM>
+__device__ __forceinline__ void expand_fp6_tile_to_fp8(typename KTraits::DTypeKV* smem_fp6,
+                                                       const float* kv_scales,
+                                                       uint32_t kv_head_idx,
+                                                       uint32_t thread_id) {
+  using DTypeKV = typename KTraits::DTypeKV;
+  static_assert(is_mjolnir_fp6_type_v<DTypeKV>, "fp6 expand needs the Mjolnir fp6 KV type");
+  constexpr SwizzleMode SWIZZLE = KTraits::SWIZZLE_MODE_KV;
+  constexpr uint32_t NUM_THREADS = KTraits::NUM_THREADS;
+  constexpr uint32_t CTA_TILE_KV = KTraits::CTA_TILE_KV;
+  constexpr uint32_t FP6_COLS = HEAD_DIM / upcast_size<DTypeKV>();
+  constexpr uint32_t NUM_B128 = CTA_TILE_KV * FP6_COLS;
+
+  b128_t* base = (b128_t*)smem_fp6;
+#pragma unroll
+  for (uint32_t idx = thread_id; idx < NUM_B128; idx += NUM_THREADS) {
+    uint32_t row = idx / FP6_COLS, col = idx % FP6_COLS;
+    b128_t* slot = base + get_permuted_offset<SWIZZLE, FP6_COLS>(row, col);
+    // MJOLNIR_FP6_KV: with the scales absent (the recommended arrangement --
+    // K folds into Q host-side, V posts to the output) the expand emits the
+    // raw e4m3 codes.
+    const float* sc =
+        kv_scales ? kv_scales + (size_t)kv_head_idx * HEAD_DIM + col * 16 : nullptr;
+    const uint8_t* in = reinterpret_cast<const uint8_t*>(slot);
+    alignas(16) uint8_t out[16];
