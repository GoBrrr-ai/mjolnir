@@ -513,6 +526,19 @@ class Qwen4ExpQSAAttention(Qwen3NextAttention, AttentionLayerBase):
         return self.attn_backend
 
     def get_kv_cache_spec(self, vllm_config: VllmConfig) -> KVCacheSpec:
+        if self.kv_cache_dtype == "fp6_e2m3":  # THOR_QWEN4_QSA_FP6
+            # mjolnir packed e2m3: 4 codes / 3 bytes -- the cell is K|V rows
+            # of d*6/8 bytes; the swap impl writes/reads the packed pool and
+            # every stock fallback expands touched pages to e4m3 (kvfp6).
+            row = self.head_dim * 6 // 8
+            return FullAttentionSpec(
+                block_size=vllm_config.cache_config.block_size,
+                num_kv_heads=self.num_kv_heads,
+                head_size=row,
+                head_size_v=row,
+                dtype=torch.uint8,
+                kv_quant_mode=get_kv_quant_mode("fp6_e2m3"),
+            )
         return FullAttentionSpec(
             block_size=vllm_config.cache_config.block_size,
             num_kv_heads=self.num_kv_heads,
