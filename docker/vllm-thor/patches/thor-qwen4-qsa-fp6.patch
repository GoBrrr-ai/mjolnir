+            from vllm.config.cache import get_kv_cache_dtype_handler
+
+            handler = get_kv_cache_dtype_handler(self.kv_cache_dtype)
+            if handler is None:
+                raise
+            torch_dtype = handler.torch_dtype()
+        self.kv_cache_torch_dtype = torch_dtype
         if self.kv_cache_torch_dtype not in (torch.bfloat16, torch.uint8):
