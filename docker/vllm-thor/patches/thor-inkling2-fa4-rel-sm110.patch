+def _thor_fa4_rel() -> bool:
+    """THOR_INKLING2_FA4_REL: run the FA4 sheared-bias rel-attention on
+    sm_110 too. The stock gate is family(100); on Thor the kernel is the
+    tcgen05 path (runtime-compiled to sm_110a SASS by the image's
+    FLASHINFER_CUDA_ARCH_LIST -- no driver JIT, unlike the FA2/FA3 ext
+    wheels whose cubins are sm_80/sm_90a only) and the mjolnir image
+    carries the FA4-on-sm110 patch stack. MJOLNIR_INKLING2_FA4_REL=0
+    forces the Triton fallback."""
+    import os
+
+    from vllm.platforms import current_platform
+
+    return current_platform.is_device_capability_family(110) and os.environ.get(
+        "MJOLNIR_INKLING2_FA4_REL", "1"
+    ) != "0"
+
