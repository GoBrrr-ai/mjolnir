# Per-project secrets: one checkout = one token set. .env is gitignored and
# never committed; wt step copy-ignored carries it into new worktrees while
# this file arrives via checkout. The explicit path loads ONLY the root .env —
# configs/**/.env are committed serving-config sidecars, not credentials.
#
# .env holds (see docs/faq for the token's fine-grained permissions):
#   GH_TOKEN=github_pat_…        # gh + worktrunk PR/CI features
#   GITHUB_PAT_TOKEN=github_pat_…  # the repo's API tooling (same PAT)
dotenv_if_exists .env
