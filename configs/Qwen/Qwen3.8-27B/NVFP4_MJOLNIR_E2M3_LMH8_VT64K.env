# env for NVFP4_MJOLNIR_E2M3_LMH8_VT64K (KEY=VALUE; {configs} = this directory in the container)
MJOLNIR_LM_HEAD=fp8
MJOLNIR_DRAFT_VOCAB={configs}/draft_vocab.json
MJOLNIR_DRAFT_VOCAB_SIZE=65536
# the drafter uses the trimmed fp8 head and the target only the fp8 quant method: free the bf16 copy (+1.2 GiB KV)
MJOLNIR_LM_HEAD_DROP_BF16=1
