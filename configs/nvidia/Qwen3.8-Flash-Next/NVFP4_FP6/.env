# Qwen3.8-Flash-Next serving stack (docker/vllm-thor/PATCHES.md) — E1/E4
# control: identical set to NVFP4_SFP8; the KV-dtype axis lives in
# config.yaml (fp8_e4m3 here, bf16 in NVFP4_SFP8).
# PIECEWISE graphs need breakable CUDA graphs (no compiled submodule); vLLM
# auto-enables them for this model unless the variable is set, and the CLI's
# container default sets 0.
VLLM_USE_BREAKABLE_CUDAGRAPH=1
VLLM_MARLIN_USE_ATOMIC_ADD=0
# PLE table from the checkpoint files (engram-config disk_offload in config.yaml):
# mjolnir's 0.5 GiB GPU CLOCK slot pool and prefetch in front of vLLM's reader
MJOLNIR_PLE_DISK_PREFETCH=1
MJOLNIR_PLE_DISK_CACHE_GB=0.5
# drafter: 47K draft vocabulary, FP8 draft head and dense layers, FULL graphs
MJOLNIR_DRAFT_VOCAB={configs}/kv_scales/draft_vocab.json
MJOLNIR_DRAFT_VOCAB_SIZE=65536
QWEN4EXP_DRAFT_HEAD_FP8=1
QWEN4EXP_MTP_DENSE_FP8=1
QWEN4EXP_FP8_FORMAT=fp8_per_block
MJOLNIR_SPEC_STEP_DRAFT_FULL_CG=1
# target: screened head, FP8 side layers with the QSA indexer BF16 (C1), FP8 hyperconnections (C2)
QWEN4EXP_SIDE_FP8=1
QWEN4EXP_SIDE_FP8_SKIP=self_attn.indexer.index_qk_proj
QWEN4EXP_HC_FP8=1
MJOLNIR_MXFP8_TACTIC=256:8
# E1 treatment: the Mjolnir QSA decode swap (needs the fp8 cache; the
# bf16 cells fall back to stock on every step)
MJOLNIR_ATTN_QSA=1

# ---- the composite's FP8 heads (the user's item 7; the LMH8 stack) ----
MJOLNIR_LM_HEAD=fp8

# ---- E4: the packed-fp6 (e2m3) QSA pools (the swap writes/reads them;
# stock fallbacks expand touched pages to e4m3) ----
MJOLNIR_ATTN_KV_SCALES={configs}/kv_scales/e2m3.json

# the fp6/calibration route: the NOT-fused path (impl.do_kv_cache_update =
# the mjolnir writer + the calibration observer; the fused writer's
# packed-cell semantics are unproven) -- thor-qwen4-qsa-fp6.patch
MJOLNIR_QSA_NOFUSED=1
