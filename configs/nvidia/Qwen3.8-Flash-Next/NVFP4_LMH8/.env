# Qwen3.8-Flash-Next serving stack (docker/vllm-thor/PATCHES.md).
# PIECEWISE graphs need breakable CUDA graphs (no compiled submodule); vLLM
# auto-enables them for this model unless the variable is set, and the CLI's
# container default sets 0.
VLLM_USE_BREAKABLE_CUDAGRAPH=1
VLLM_MARLIN_USE_ATOMIC_ADD=0
# PLE table from the checkpoint files (engram-config disk_offload in config.yaml):
# mjolnir's 0.5 GiB GPU CLOCK slot pool and prefetch in front of vLLM's reader
MJOLNIR_PLE_DISK_PREFETCH=1
MJOLNIR_PLE_DISK_CACHE_GB=0.5
# drafter: 47K draft vocabulary, FP8 draft head and dense layers, FULL graphs
MJOLNIR_DRAFT_VOCAB={configs}/draft_vocab.json
QWEN4EXP_DRAFT_HEAD_FP8=1
QWEN4EXP_MTP_DENSE_FP8=1
QWEN4EXP_FP8_FORMAT=fp8_per_block
MJOLNIR_SPEC_STEP_DRAFT_FULL_CG=1
# target: mjolnir plain FP8 lm_head (E2 arm; the screened head is the NVFP4_SFP8 arm), FP8 side layers with the QSA indexer BF16 (C1), FP8 hyperconnections (C2)
QWEN4EXP_SIDE_FP8=1
QWEN4EXP_SIDE_FP8_SKIP=self_attn.indexer.index_qk_proj
QWEN4EXP_HC_FP8=1
MJOLNIR_MXFP8_TACTIC=256:8
MJOLNIR_LM_HEAD=fp8
