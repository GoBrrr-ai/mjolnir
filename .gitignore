__pycache__/
*.py[cod]
.venv/
.playwright-mcp/
.pytest_cache/
.ruff_cache/
.env
# the configs' env sidecars are plain mjolnir knobs (calibration paths, feature
# flags) and ride with the configs; real secrets stay out
!configs/**/.env
# coverage artifacts (the CI test stage writes these; they regenerate)
.coverage
.coverage.*
coverage.xml
.coverage_html/
dist/
build/
*.egg-info/
.mjolnir-state.json
data/
runs/
# benchmark data: the structured verify results are committed (charts,
# README and docs are rendered from them); logs and e2e raw dirs are not
benchmarks/raw/*
!benchmarks/raw/verify/
# accuracy: accuracy.json per run is committed; each leg's tool-eval-bench
# workdir (SQLite, trace reports, server log) is not
!benchmarks/raw/accuracy/
benchmarks/raw/accuracy/*/*/
benchmarks/logs/
benchmarks/staging/
task/

# autoresearch: the live ledger is untracked (discards are `git reset --hard`);
# `mjolnir autoresearch export` snapshots it into research/runs/<tag>/
research/ledger.jsonl
research/ledger.tsv
# …and the exported runs ARE committed (the generic runs/ rule above would hide them)
!research/runs/
/cutlass/
/fa2/
/llamacpp/
